# OWASP Sentinel Configuration Template
# Copy this file to .env for local adjustments

PROJECT_NAME="OWASP Sentinel"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Bindings
HOST=127.0.0.1
PORT=8000

# Scanner Safety & SSRF Guard Defaults
ALLOW_PRIVATE_IPS_DEFAULT=False
MAX_TARGET_URL_LENGTH=2048
DEFAULT_REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Database Configuration (SQLite default for initial phases)
DATABASE_URL=sqlite:///./sentinel.db

