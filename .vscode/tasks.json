{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Backend (8001) + Ngrok",
      "type": "shell",
      "command": "Start-Job -ScriptBlock { Start-Sleep -Seconds 3; try { $t = Invoke-RestMethod -Uri 'http://127.0.0.1:8001/api/v1/tunnel/start' -Method Post -ContentType 'application/json' -Body '{}' -TimeoutSec 15; Write-Host \"[+] Ngrok: $($t.public_url)\" -ForegroundColor Green } catch { Write-Host \"[!] Ngrok warning: $($_.Exception.Message)\" -ForegroundColor Yellow } } | Out-Null; python -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sentinel-backend",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "2. Frontend (5173)",
      "type": "shell",
      "command": "npm.cmd run dev",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sentinel-frontend",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "3. Kali Docker Container + Logs",
      "type": "shell",
      "command": "docker compose up -d --build kali; if ($?) { docker compose logs -f --tail 40 kali }",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "sentinel-kali-docker",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Start All Services (3 Terminals)",
      "dependsOn": [
        "1. Backend (8001) + Ngrok",
        "2. Frontend (5173)",
        "3. Kali Docker Container + Logs"
      ],
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "XSSSpect Scan",
      "type": "shell",
      "command": "python -m xssspect.main scan --url ${input:targetUrl}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],
  "inputs": [
    {
      "id": "targetUrl",
      "type": "promptString",
      "description": "Authorized target URL to assess with XSSSpect",
      "default": "https://example.com/search?q=test"
    }
  ]
}
